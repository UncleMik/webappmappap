# Reference only. Put actual secrets in /etc/wep-pril/auth.env (root:root, 0600).
# Never put actual values in Git, chat, browser code, screenshots or command arguments.
AUTH_ENABLED=false
AUTH_ORIGIN=https://app.legkie-rody.ru
AUTH_PORT=3001
AUTH_DATABASE_URL=
AUTH_HMAC_SECRET=
AUTH_DB_POOL_SIZE=10
# Conservative budgets; agree actual limits with both providers before enabling.
AUTH_MAILS_PER_MINUTE=120
AUTH_GETCOURSE_PER_MINUTE=30
UNISENDER_API_KEY=
UNISENDER_TEMPLATE_ID=
# Enable only after the provider explicitly permits transactional mail without unsubscribe.
UNISENDER_TRANSACTIONAL_APPROVED=false
AUTH_REPLY_TO=
GETCOURSE_ORIGIN=https://legkierody.ru
GETCOURSE_IMPORT_KEY=
# Optional confirmed owner of the single Club chat; keep the real account ID private.
CLUB_OWNER_USER_ID=
